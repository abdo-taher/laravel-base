{
    "name": "ModuleManager",
    "category": "Foundation",
    "version": "0.2.0",
    "ownership": "base-owned",
    "description": "Orchestrates discovery, validation, dependency resolution, capability registration, and boot ordering of Base packages and project modules.",
    "namespace": "Base\\Foundation\\ModuleManager",
    "dependencies": {
        "required": [
            {
                "capability": "manifest.read",
                "version": "^1.0"
            },
            {
                "capability": "dependency.resolve",
                "version": "^1.0"
            },
            {
                "capability": "capability.resolve",
                "version": "^1.0"
            }
        ],
        "optional": []
    },
    "provides": [
        {
            "capability": "module.manager",
            "version": "0.2.0"
        },
        {
            "capability": "module.discovery",
            "version": "0.2.0"
        }
    ],
    "extension_points": [],
    "data": {
        "tables": []
    },
    "events": {
        "publishes": [],
        "consumes": []
    },
    "lifecycle": {
        "enableable": false,
        "disable_policy": "not-applicable"
    },
    "security": {
        "classification": "internal"
    }
}
