{
    "name": "CapabilityRegistry",
    "category": "Foundation",
    "version": "0.1.0",
    "ownership": "base-owned",
    "description": "Registers and resolves versioned runtime capabilities through explicit provider definitions.",
    "namespace": "Base\\Foundation\\CapabilityRegistry",
    "dependencies": {
        "required": [
            {
                "package": "SharedKernel",
                "version": "^0.1"
            }
        ],
        "optional": []
    },
    "provides": [
        {
            "capability": "capability.resolve",
            "version": "1.0.0"
        }
    ],
    "extension_points": [],
    "data": {
        "tables": []
    },
    "events": {
        "publishes": [],
        "consumes": []
    },
    "lifecycle": {
        "enableable": false,
        "disable_policy": "not-applicable"
    },
    "security": {
        "classification": "internal"
    }
}
